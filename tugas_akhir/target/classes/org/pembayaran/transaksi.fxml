<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="768.0" prefWidth="1366.0" styleClass="pane" stylesheets="@transaksi.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.openjfx.GymPaymentController">
   <children>
      <!-- Header Section - FIXED -->
      <Pane prefHeight="110.0" prefWidth="1366.0" styleClass="dashboard-header" AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <children>
            <!-- Logo -->
            <ImageView fitHeight="85.0" fitWidth="105.0" layoutX="18.0" layoutY="12.0" preserveRatio="true">
               <image>
                  <Image url="@../icon/logo.png" />
               </image>
            </ImageView>
            
            <VBox alignment="CENTER_LEFT" layoutX="125.0" layoutY="25.0" prefHeight="50.0" prefWidth="380.0">
               <children>
                  <Label styleClass="company-name" text="GYM PAYMENT SYSTEM" />
                  <Label styleClass="company-subtitle" text="Sistem Pembayaran Member &amp; Non-Member" />
               </children>
            </VBox>
            
            <!-- Info Petugas yang Login -->
            <VBox alignment="CENTER_RIGHT" layoutX="800.0" layoutY="25.0" prefHeight="63.0" prefWidth="300.0" styleClass="user-info-box">
               <children>
                  <Label styleClass="user-info-label" text="Petugas:" />
                  <Label fx:id="petugasNameLabel" styleClass="user-info-value" text="-" />
                  <Label fx:id="petugasRoleLabel" styleClass="user-info-role" text="-" />
               </children>
            </VBox>
            
            <VBox alignment="CENTER_RIGHT" layoutX="1120.0" layoutY="25.0" prefHeight="63.0" prefWidth="142.0">
               <children>
                  <Label fx:id="clockLabel" styleClass="time-label" text="01:02:03" textAlignment="CENTER" />
                  <Label fx:id="dateLabel" styleClass="date-label" text="Senin, 01 Jan 2024" textAlignment="CENTER" />
               </children>
            </VBox>
         </children>
      </Pane>

      <!-- ScrollPane untuk Konten Utama - FIXED -->
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" 
                  styleClass="scroll-pane" 
                  AnchorPane.topAnchor="110.0" 
                  AnchorPane.bottomAnchor="0.0" 
                  AnchorPane.leftAnchor="0.0" 
                  AnchorPane.rightAnchor="0.0">
         <content>
            <VBox spacing="20" styleClass="main-content">
               <padding>
                  <Insets bottom="30.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               
               <children>
                  <!-- Info Section -->
                  <Pane prefHeight="140.0" styleClass="info-box">
                     <children>
                        <Label layoutX="40.0" layoutY="25.0" styleClass="info-title" text="Sistem Pembayaran Gym" />
                        <Label layoutX="40.0" layoutY="55.0" styleClass="info-subtitle" text="Member &amp; Non-Member" />
                        <Label layoutX="40.0" layoutY="85.0" styleClass="info-description" text="• Non-member paket harian (Reguler &amp; VIP)&#10;• Diskon khusus: Pelajar/PNS/TNI/POLRI (10%), Pelaku Budaya/Ulama (15%), Guru (20%)" wrapText="true" />
                     </children>
                  </Pane>

                  <!-- Form Section -->
                  <VBox spacing="25" styleClass="form-container">
                     <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                     </padding>
                     
                     <children>
                        <!-- Info Petugas yang Melayani -->
                        <VBox spacing="10" styleClass="petugas-section">
                           <Label styleClass="section-title" text="Petugas yang Melayani" />
                           <GridPane hgap="15" vgap="10">
                             <columnConstraints>
                               <ColumnConstraints prefWidth="200" />
                               <ColumnConstraints prefWidth="300" />
                               <ColumnConstraints prefWidth="200" />
                               <ColumnConstraints prefWidth="300" />
                             </columnConstraints>
                             <rowConstraints>
                               <RowConstraints prefHeight="35" />
                             </rowConstraints>
                             
                             <Label styleClass="input-label" text="Username" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                             <TextField fx:id="petugasUsernameField" editable="false" prefHeight="35.0" prefWidth="300.0" styleClass="petugas-field" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                             
                             <Label styleClass="input-label" text="Nama Petugas" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                             <TextField fx:id="petugasNamaField" editable="false" prefHeight="35.0" prefWidth="300.0" styleClass="petugas-field" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                           </GridPane>
                        </VBox>

                        <!-- Jenis Pembayaran -->
                        <VBox spacing="15">
                           <Label styleClass="section-title" text="Jenis Pembayaran" />
                           <HBox spacing="20">
                              <children>
                                 <RadioButton fx:id="memberRadio" mnemonicParsing="false" selected="true" styleClass="payment-radio" text="Member">
                                    <toggleGroup>
                                       <ToggleGroup fx:id="paymentTypeGroup" />
                                    </toggleGroup>
                                 </RadioButton>
                                 <RadioButton fx:id="nonMemberRadio" mnemonicParsing="false" styleClass="payment-radio" text="Non-Member" toggleGroup="$paymentTypeGroup" />
                              </children>
                           </HBox>
                        </VBox>

                        <!-- Section untuk Member -->
                        <VBox fx:id="memberSection" spacing="20">
                           <children>
                              <!-- Barcode Section -->
                              <VBox spacing="10">
                                 <Label styleClass="input-label" text="Barcode Member" />
                                 <HBox alignment="CENTER_LEFT" spacing="15">
                                    <TextField fx:id="barcodeField" prefHeight="42.0" prefWidth="400.0" promptText="Masukkan barcode member" styleClass="input-field" />
                                    <ToggleButton fx:id="scannerToggleButton" prefHeight="42.0" prefWidth="120.0" selected="true" styleClass="scanner-toggle" text="Scanner" />
                                 </HBox>
                                 <Label fx:id="scannerStatusLabel" styleClass="status-label" text="✓ Scanner aktif" />
                              </VBox>

                              <!-- Member Form Grid -->
                              <GridPane fx:id="memberFormGrid" hgap="20" vgap="15">
                                <columnConstraints>
                                  <ColumnConstraints prefWidth="450" />
                                  <ColumnConstraints prefWidth="450" />
                                </columnConstraints>
                                <rowConstraints>
                                  <RowConstraints prefHeight="35" />
                                  <RowConstraints prefHeight="45" />
                                  <RowConstraints prefHeight="35" />
                                  <RowConstraints prefHeight="45" />
                                  <RowConstraints prefHeight="35" />
                                  <RowConstraints prefHeight="45" />
                                  <RowConstraints prefHeight="35" />
                                  <RowConstraints prefHeight="45" />
                                </rowConstraints>
                                
                                <!-- Kolom 1 -->
                                <Label styleClass="input-label" text="Tanggal Transaksi" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <DatePicker fx:id="transactionDateField" prefHeight="42.0" prefWidth="450.0" styleClass="date-picker" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                
                                <Label fx:id="packageLabel" styleClass="input-label" text="Pilih Paket Member" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <ComboBox fx:id="packageComboBox" prefHeight="42.0" prefWidth="450.0" styleClass="combo-box" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                
                                <Label styleClass="input-label" text="Pekerjaan" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                <TextField fx:id="memberPekerjaanField" editable="false" prefHeight="42.0" prefWidth="450.0" styleClass="input-field-disabled" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                                
                                <!-- Kolom 2 -->
                                <Label styleClass="input-label" text="Nama Member" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                <TextField fx:id="memberNameField" editable="false" prefHeight="42.0" prefWidth="450.0" styleClass="input-field-disabled" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                
                                <Label styleClass="input-label" text="Masa Berlaku Saat Ini" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                <TextField fx:id="membershipValidityField" editable="false" prefHeight="42.0" prefWidth="450.0" styleClass="input-field-disabled" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                
                                <Label styleClass="input-label" text="Durasi Member Saat Ini" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                <TextField fx:id="membershipDurationField" editable="false" prefHeight="42.0" prefWidth="450.0" styleClass="input-field-disabled" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                                
                                <Label fx:id="discountLabel" styleClass="discount-label" text="" GridPane.columnIndex="1" GridPane.rowIndex="6" GridPane.rowSpan="2" />
                                
                                <Label styleClass="input-label" text="Status Diskon" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                                <Label fx:id="discountStatusLabel" styleClass="discount-status-label" text="Tidak ada diskon" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                              </GridPane>
                           </children>
                        </VBox>

                        <!-- Section untuk Non-Member -->
                        <VBox fx:id="nonMemberSection" spacing="20" visible="false">
                           <children>
                              <!-- Data Non-Member -->
                              <VBox spacing="15">
                                 <Label styleClass="input-label" text="Data Non-Member" />
                                 
                                 <!-- ID Non-Member -->
                                 <VBox spacing="8">
                                    <Label styleClass="input-label" text="ID Non-Member" />
                                    <TextField fx:id="nonMemberIdField" editable="false" prefHeight="42.0" prefWidth="450.0" styleClass="input-field-disabled" />
                                 </VBox>
                                 
                                 <!-- Nama Lengkap -->
                                 <VBox spacing="8">
                                    <Label styleClass="input-label" text="Nama Lengkap" />
                                    <TextField fx:id="nonMemberNameField" prefHeight="42.0" prefWidth="450.0" promptText="Masukkan nama lengkap" styleClass="input-field" />
                                 </VBox>
                                 
                                 <!-- Tanggal Masuk -->
                                 <VBox spacing="8">
                                    <Label styleClass="input-label" text="Tanggal Masuk" />
                                    <DatePicker fx:id="nonMemberDateField" prefHeight="42.0" prefWidth="450.0" styleClass="date-picker" />
                                 </VBox>
                              </VBox>

                              <!-- Tipe Non-Member -->
                              <VBox fx:id="nonMemberTypeSection" spacing="8">
                                 <Label styleClass="input-label" text="Tipe Non-Member" />
                                 <ComboBox fx:id="nonMemberTypeComboBox" prefHeight="42.0" prefWidth="450.0" styleClass="combo-box" />
                              </VBox>
                           </children>
                        </VBox>

                        <!-- Section Pembayaran -->
                        <VBox spacing="20">
                           <Label styleClass="section-title" text="Detail Pembayaran" />
                           
                           <!-- Payment Details Grid -->
                           <GridPane hgap="20" vgap="15">
                             <columnConstraints>
                               <ColumnConstraints prefWidth="450" />
                               <ColumnConstraints prefWidth="450" />
                             </columnConstraints>
                             <rowConstraints>
                               <RowConstraints prefHeight="35" />
                               <RowConstraints prefHeight="55" />
                               <RowConstraints prefHeight="35" />
                               <RowConstraints prefHeight="55" />
                             </rowConstraints>
                             
                             <!-- Kolom 1 -->
                             <Label styleClass="input-label" text="Total Pembayaran" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                             <TextField fx:id="totalPaymentField" editable="false" prefHeight="50.0" prefWidth="450.0" styleClass="payment-field-total" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                             
                             <Label styleClass="input-label" text="Kembalian" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                             <TextField fx:id="changeAmountField" editable="false" prefHeight="50.0" prefWidth="450.0" styleClass="payment-field-change" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                             
                             <!-- Kolom 2 -->
                             <Label styleClass="input-label" text="Uang Dibayar" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                             <TextField fx:id="paidAmountField" prefHeight="50.0" prefWidth="450.0" promptText="Masukkan jumlah uang yang dibayar" styleClass="payment-field-paid" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                             
                             <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2" GridPane.rowSpan="2">
                                <Label styleClass="input-label" text="Detail Pembayaran" />
                                <Label fx:id="paymentDetailLabel" styleClass="payment-detail-text" text="Pilih paket untuk melihat detail" wrapText="true" />
                             </VBox>
                           </GridPane>
                        </VBox>

                        <!-- Tombol Aksi -->
                        <HBox alignment="CENTER" spacing="15">
                           <padding>
                              <Insets top="20.0" bottom="20.0" />
                           </padding>
                           <children>
                              <Button fx:id="processButton" prefHeight="45.0" prefWidth="130.0" styleClass="primary-button" text="Proses" />
                              <Button fx:id="resetButton" prefHeight="45.0" prefWidth="130.0" styleClass="secondary-button" text="Reset" />
                              <Button fx:id="backButton" prefHeight="45.0" prefWidth="130.0" styleClass="secondary-button" text="Kembali" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</AnchorPane>