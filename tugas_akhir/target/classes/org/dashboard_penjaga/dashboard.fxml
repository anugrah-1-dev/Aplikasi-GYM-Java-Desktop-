<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="768.0" prefWidth="1366.0" styleClass="body" stylesheets="@dashboard.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.openjfx.DashboardController">
   <children>
      <!-- Menu Buttons in 3-column Layout -->
      <Button fx:id="btnDaftarMember" contentDisplay="TOP" layoutX="205.0" layoutY="220.0" mnemonicParsing="false" onAction="#handleDaftarMemberClick" prefHeight="160.0" prefWidth="220.0" styleClass="button-menu member-button" text="Daftar Member">
         <graphic>
            <ImageView fitHeight="70.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../icon/icon member.png" />
               </image>
            </ImageView>
         </graphic>
         <font>
            <Font name="Segoe UI Bold" size="14.0" />
         </font>
      </Button>
      
      <Button fx:id="btnTransaksi" contentDisplay="TOP" layoutX="573.0" layoutY="220.0" mnemonicParsing="false" onAction="#handleTransaksiClick" prefHeight="160.0" prefWidth="220.0" styleClass="button-menu transaksi-button" text="Transaksi">
         <graphic>
            <ImageView fitHeight="70.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../icon/transaksi.png" />
               </image>
            </ImageView>
         </graphic>
         <font>
            <Font name="Segoe UI Bold" size="14.0" />
         </font>
      </Button>
      
      <Button fx:id="btnHistoryPenjaga" contentDisplay="TOP" layoutX="932.0" layoutY="220.0" mnemonicParsing="false" onAction="#handleHistoryPenjagaClick" prefHeight="160.0" prefWidth="220.0" styleClass="button-menu history-button" text="Data Member">
         <graphic>
            <ImageView fitHeight="70.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../icon/table.png" />
               </image>
            </ImageView>
         </graphic>
         <font>
            <Font name="Segoe UI Bold" size="14.0" />
         </font>
      </Button>

      <!-- Header Section -->
      <Pane prefHeight="120.0" prefWidth="1366.0" styleClass="dashboard-header">
         <children>
            <ImageView fitHeight="90.0" fitWidth="90.0" layoutX="14.0" layoutY="12.0" styleClass="header-logo">
               <image>
                  <Image url="@../icon/logo.png" />
               </image>
            </ImageView>
            <Label layoutX="120.0" layoutY="25.0" prefHeight="40.0" prefWidth="350.0" styleClass="company-name" text="BISA GYM">
               <font>
                  <Font name="Segoe UI Bold" size="28.0" />
               </font>
            </Label>
            <Label layoutX="120.0" layoutY="65.0" prefHeight="25.0" prefWidth="350.0" styleClass="company-subtitle" text="Management System">
               <font>
                  <Font name="Segoe UI Semibold" size="16.0" />
               </font>
            </Label>
            
            <!-- Jam dan Tanggal -->
            <Label fx:id="lblDateTime" layoutX="1050.0" layoutY="70.0" styleClass="date-time" text="">
               <font>
                  <Font name="Segoe UI Bold" size="13.0" />
               </font>
            </Label>
            
            <!-- Label untuk menampilkan nama penjaga yang login -->
            <Label fx:id="lblNamaPenjaga" layoutX="1050.0" layoutY="25.0" styleClass="user-name" text="">
               <font>
                  <Font name="Segoe UI Bold" size="14.0" />
               </font>
            </Label>
            <Label fx:id="lblUserRole" layoutX="1050.0" layoutY="45.0" styleClass="user-role" text="">
               <font>
                  <Font name="Segoe UI" size="12.0" />
               </font>
            </Label>
         </children>
      </Pane>

      <!-- Logout Section -->
      <Pane layoutX="50.0" layoutY="620.0" prefHeight="70.0" prefWidth="180.0" styleClass="logout-container">
         <children>
            <Button fx:id="btnLogout" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#handleLogoutClick" prefHeight="50.0" prefWidth="160.0" styleClass="logout-button" text="Keluar Sistem">
               <font>
                  <Font name="Segoe UI Semibold" size="13.0" />
               </font>
            </Button>
            <ImageView fitHeight="18.0" fitWidth="18.0" layoutX="22.0" layoutY="26.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../icon/icons8-logout-50.png" />
               </image>
            </ImageView>
         </children>
      </Pane>
   </children>
</Pane>
