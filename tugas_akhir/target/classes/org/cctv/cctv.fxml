<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane prefHeight="768.0" prefWidth="1366.0" styleClass="body" stylesheets="@cctv.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.openjfx.MemberControllerT">

   <children>
      <!-- Header -->
      <Pane prefHeight="110.0" prefWidth="1366.0" styleClass="bagian_atas">
         <children>
            <ImageView fitHeight="85.0" fitWidth="85.0" layoutX="14.0" layoutY="13.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../icon/logo.png" />
               </image>
            </ImageView>
            <Label layoutX="115.0" layoutY="30.0" text="Teman Fitness" textFill="WHITE">
               <font>
                  <Font name="Segoe UI" size="22.0" />
               </font>
            </Label>
            <Label layoutX="115.0" layoutY="60.0" text="Daftar Member" textFill="WHITE">
               <font>
                  <Font name="Segoe UI" size="16.0" />
               </font>
            </Label>
            <ImageView fx:id="imgKembali" fitHeight="50.0" fitWidth="50.0" layoutX="1250.0" layoutY="30.0" onMouseClicked="#kembaliKeDashboard" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../icon/WhatsApp_Image_2025-05-18_at_22.45.11-removebg-preview.png" />
               </image>
            </ImageView>
         </children>
      </Pane>

      <!-- Panel Toolbar -->
      <Pane layoutX="25.0" layoutY="130.0" prefHeight="55.0" prefWidth="1316.0" styleClass="panel-toolbar">
         <children>
            <Label layoutX="0" layoutY="18" text="Cari Member:" textFill="BLACK" />
            <TextField fx:id="fieldPencarian" layoutX="90.0" layoutY="13.0" prefHeight="30.0" prefWidth="280.0" promptText="Cari berdasarkan nama, email, no HP, atau ID..." />
            
            <!-- Filter Bulan -->
            <Label layoutX="390.0" layoutY="18.0" text="Filter Bulan:" textFill="BLACK" />
            <ComboBox fx:id="comboBulan" layoutX="470.0" layoutY="13.0" prefHeight="30.0" prefWidth="140.0" promptText="Pilih Bulan" />
            
            <!-- Button Reset Filter -->
            <Button fx:id="btnResetFilter" layoutX="1200.0" layoutY="13.0" onAction="#resetFilter" prefHeight="35.0" prefWidth="110.0" styleClass="button-reset" text="Reset Filter" />
         </children>
      </Pane>

      <!-- ScrollPane untuk Tabel -->
      <ScrollPane layoutX="25.0" layoutY="195.0" 
                  prefHeight="548.0" 
                  prefWidth="1316.0" 
                  styleClass="scroll-pane-tabel" 
                  hbarPolicy="ALWAYS" 
                  vbarPolicy="AS_NEEDED"
                  fitToHeight="false"
                  fitToWidth="false"
                  hvalue="0.0"
                  vvalue="0.0"
                  pannable="true">
         <content>
            <!-- Tabel Daftar Member -->
            <TableView fx:id="tabelMember" 
                       styleClass="tabel-member"
                       prefHeight="540.0"
                       minWidth="2000.0"
                       prefWidth="2000.0"
                       maxHeight="Infinity">
               <columns>
                  <!-- Kolom No -->
                  <TableColumn fx:id="colNo" prefWidth="50.0" minWidth="50.0" maxWidth="60.0" text="No" sortable="false" />
                  
                  <!-- Kolom Foto -->
                  <TableColumn fx:id="colFoto" prefWidth="75.0" minWidth="70.0" maxWidth="80.0" text="Foto" sortable="false" />
                  
                  <!-- Kolom ID Member -->
                  <TableColumn fx:id="colMemberId" prefWidth="130.0" minWidth="120.0" maxWidth="150.0" text="ID Member" />
                  
                  <!-- Kolom NIK -->
                  <TableColumn fx:id="colNIK" prefWidth="130.0" minWidth="120.0" maxWidth="150.0" text="NIK" />
                  
                  <!-- Kolom Nama -->
                  <TableColumn fx:id="colNama" prefWidth="150.0" minWidth="140.0" maxWidth="200.0" text="Nama Lengkap" />
                  
                  <!-- Kolom Jenis Kelamin -->
                  <TableColumn fx:id="colJenisKelamin" prefWidth="100.0" minWidth="90.0" maxWidth="120.0" text="Jenis Kelamin" />
                  
                  <!-- Kolom Tanggal Lahir -->
                  <TableColumn fx:id="colTanggalLahir" prefWidth="120.0" minWidth="110.0" maxWidth="140.0" text="Tanggal Lahir" />
                  
                  <!-- Kolom Email -->
                  <TableColumn fx:id="colEmail" prefWidth="180.0" minWidth="170.0" maxWidth="250.0" text="Email" />
                  
                  <!-- Kolom Telepon -->
                  <TableColumn fx:id="colTelepon" prefWidth="120.0" minWidth="110.0" maxWidth="140.0" text="No. HP" />
                  
                  <!-- Kolom Alamat -->
                  <TableColumn fx:id="colAlamat" prefWidth="180.0" minWidth="170.0" maxWidth="250.0" text="Alamat Domisili" />
                  
                  <!-- Kolom Durasi Member -->
                  <TableColumn fx:id="colDurasiMember" prefWidth="90.0" minWidth="85.0" maxWidth="110.0" text="Durasi" />
                  
                  <!-- Kolom Tanggal Daftar -->
                  <TableColumn fx:id="colTanggalDaftar" prefWidth="120.0" minWidth="110.0" maxWidth="140.0" text="Tanggal Daftar" />
                  
                  <!-- Kolom Berlaku Hingga -->
                  <TableColumn fx:id="colBerlakuHingga" prefWidth="120.0" minWidth="110.0" maxWidth="140.0" text="Berlaku Hingga" />
                  
                  <!-- Kolom Status -->
                  <TableColumn fx:id="colStatus" prefWidth="80.0" minWidth="75.0" maxWidth="100.0" text="Status" />
                  
                  <!-- Kolom Aksi -->
                  <TableColumn fx:id="colAksi" prefWidth="100.0" minWidth="95.0" maxWidth="120.0" text="Aksi" sortable="false" />
               </columns>
            </TableView>
         </content>
      </ScrollPane>
   </children>
</Pane>